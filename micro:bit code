# Imports go at the top
from microbit import *
import random

# make a variable for player x position, set to middle
player_x = 2
display.set_pixel(player_x, 4, 9)

while True:
    # if button a is pressed
    if button_a.is_pressed() and player_x > 0:
        player_x -= 1
        
    # move player (x) left
        display.set_pixel(player_x, 4, 9)
        display.set_pixel(player_x + 1, 4, 0)
        sleep(100)
    # if button b is pressed
    if button_b.is_pressed() and player_x < 4:
        player_x += 1
    # move player (x) right
        display.set_pixel(player_x, 4, 9)
        display.set_pixel(player_x - 1, 4, 0)
        sleep(100)

    # create x and y variables for object
    object_x = (random.randint(0, 4))
    object_y = (1)
    
# set to random location along the top
# use display.set_pixel to see it on screen
    display.set_pixel(object_x, object_y, 9)
    sleep(100)
# move the object down every second
    display.set_pixel(object_x, object_y + 1, 9)
    sleep(33)
