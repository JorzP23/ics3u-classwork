# Imports go at the top
from microbit import *
import random
import music

# create x and y variables for object & set to random location along the top
object_x = (random.randrange(0, 5))
object_y = (0)

# keep track of # of frames with a frame_count variable
frame_count = 0
object_speed = 1

# create a variable for score
score = 0

# start countdown
display.scroll('3, 2, 1, GO!')

# make a variable for player x position, set to middle
player_x = 2
display.set_pixel(player_x, 4, 9)

# set amount of lives
lives = 1

# invincibility frame variable
invincibility_frames = 0

# variable to determine the type of object
object_type = 0

# brightness variables
player_brightness = 9
brightness = 9

while True:
    # if button a is pressed
    if button_a.was_pressed() and player_x > 0:
        player_x -= 1
        
    # move player (x) left
        display.set_pixel(player_x, 4, player_brightness)
        display.set_pixel(player_x + 1, 4, 0)
        
    # if button b is pressed
    if button_b.was_pressed() and player_x < 4:
        player_x += 1
        
    # move player (x) right
        display.set_pixel(player_x, 4, player_brightness)
        display.set_pixel(player_x - 1, 4, 0)
    
    # frame count constantly increases by one
    frame_count += 1
    
    # if frames == 30, then move object down
    print(frame_count, 30 // object_speed)
    if frame_count == 30 // object_speed:            
        object_y += 1
        display.set_pixel(object_x, object_y - 1, 0)
        
    # reset frame count    
        frame_count = 0
       
    # if the object reaches the bottom, move it back to the top randomly
    if object_y == 5:
        object_y = 0
        object_x = (random.randrange(0, 5))
    # increase frame_count by 1 every loop    
        object_speed += 1
        
    # add the chance for the object to spawn as a power-up
        spawn_chance = random.randrange(0, 100)
        if spawn_chance < 10:
            object_type = 2
        elif spawn_chance < 25:
            object_type = 1
        else:
            object_type = 0
            
    # invincibility timer
    if invincibility_frames > 0:
        invincibility_frames -= 1

    # brighness indicator for the different object types
    if object_type == 0:
        brightness = 9
    elif object_type == 1:
        brightness = 2
    elif object_type == 2:
        brightness = 5
    print(brightness)

    # make player blink while invincible
    if invincibility_frames > 0:
        player_brightness = 9 if ((frame_count // 3) % 2 == 0) else 3
    else:
        player_brightness = 9

    # set a speed limit
    if object_speed > 7:
        object_speed = 7
        
    # increase score by 1 every loop
        score += 1
                
    # print it out
    display.set_pixel(object_x, object_y, brightness)
    display.set_pixel(player_x, 4, player_brightness)

    # indicate amount of lives left on the top of the display
    if lives >= 1 and not (object_x == 0 and object_y == 0):
        display.set_pixel(0, 0, 3)
    elif not (object_x == 0 and object_y == 0):
        display.set_pixel(0, 0, 0)

    if lives >= 2 and not (object_x == 1 and object_y == 0):
        display.set_pixel(1, 0, 3)
    elif not (object_x == 1 and object_y == 0):
        display.set_pixel(1, 0, 0)

    if lives >= 3 and not (object_x == 2 and object_y == 0):
        display.set_pixel(2, 0, 3)
    elif not (object_x == 2 and object_y == 0):
        display.set_pixel(2, 0, 0)

    if lives >= 4 and not (object_x == 3 and object_y == 0):
        display.set_pixel(3, 0, 3)
    elif not (object_x == 3 and object_y == 0):
        display.set_pixel(3, 0, 0)

    if lives >= 5 and not (object_x == 4 and object_y == 0):
        display.set_pixel(4, 0, 3)
    elif not (object_x == 4 and object_y == 0):
        display.set_pixel(4, 0, 0)
            
    sleep(33)

    # power up sequences
    if player_x == object_x and object_y == 4:
        if object_type == 1:
            lives += 1
            if lives == 5:
                lives = 5
            object_speed += 1
        elif object_type == 2:
            invincibility_frames = 150
            object_speed += 1
        elif object_type == 0:
            if invincibility_frames == 0:
                lives -= 1
                object_speed += 1
                
    # reset the object back to the top and reset player
        display.set_pixel(object_x, object_y, 0)
        object_y = 0
        object_x = random.randrange(0, 5)
        display.set_pixel(player_x, 4, player_brightness)

    # reroll object type
        spawn_chance = random.randrange(0, 100)
        if spawn_chance < 10:
            object_type = 2
        elif spawn_chance < 25:
            object_type = 1
        else:
            object_type = 0
        
    # game over sequence
        if lives == 0:
            display.scroll('Game Over')
            display.scroll('Score:')
            display.scroll(score)
            break
