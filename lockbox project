from microbit import *

# SERVO
SERVO_LOCKED = 26
SERVO_UNLOCKED = 128 

# Password
password = 6
guess = 0
locked = True

# startup sequence
pin0.write_analog(SERVO_UNLOCKED)
display.scroll("Close Lid")
sleep(2000)
pin0.write_analog(SERVO_LOCKED)

while True:
    display.show(guess)
    if button_a.was_pressed():
        guess+=1
    if guess > 9:
        guess = 0
    if button_b.was_pressed():
        if locked:
            if guess == password:
                guess = 0
                pin0.write_analog(SERVO_UNLOCKED)
                display.scroll("YES")
                locked = False
            else:
                display.scroll("NO")
                sleep(500)
        else:
            pin0.write_analog(SERVO_LOCKED)
            display.show(Image.DIAMOND)
            locked = True
            sleep(500)
        
            
