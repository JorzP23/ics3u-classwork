from microbit import *

# SERVO
SERVO_LOCKED = 30
SERVO_UNLOCKED = 128

# password & choice variables
password = 6
guess = 0

# startup sequence
pin0.write_analog(SERVO_UNLOCKED)
display.scroll("Close Lid")
sleep(2000)
pin0.write_analog(SERVO_LOCKED)
locked = True

# cycling numbers
while True:
    display.show(guess)
    if button_a.was_pressed():
        guess+=1
    if guess > 9:
        guess = 0
        
# press b to choose number
    if button_b.was_pressed():
        if locked:
            if guess == password:
                guess = 0
                pin0.write_analog(SERVO_UNLOCKED)
                display.scroll("YES")
                locked = False
            else:
                display.scroll("NO")
                sleep(500)

# lock with b while unlocked
        else:
            pin0.write_analog(SERVO_LOCKED)
            display.show(Image.DIAMOND)
            locked = True
            sleep(500)
        
            
